# ── Copy this to .env and fill in your values ──────────────────────
# Generate a secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

SECRET_KEY=your-very-secret-key-change-this

# Set to False in production
DEBUG=False

# Comma-separated allowed hosts
# Example: ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,.railway.app
ALLOWED_HOSTS=localhost,127.0.0.1

# Full PostgreSQL URL from your host (Railway/Render/Supabase etc.)
# Example: postgres://user:password@host:5432/dbname
DATABASE_URL=sqlite:///db.sqlite3

# Your production domain (used in QR code URLs — MUST be https:// in production)
SITE_URL=https://yourdomain.com

# Rate limiting: max 5 form submissions per IP per hour
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW=3600

# Enable HTTPS redirect in production (set True when behind SSL)
SECURE_SSL_REDIRECT=False
